# PostgreSQL — Neon / Vercel Marketplace Postgres.
# Existing Vercel Postgres names still work: POSTGRES_PRISMA_URL, POSTGRES_URL, POSTGRES_URL_NON_POOLING.
DATABASE_URL="postgresql://ostodvandi:ostodvandi@127.0.0.1:5432/ostodvandi"
# Direct (non-pooled) URL for Prisma migrate. Same as DATABASE_URL locally.
DIRECT_URL="postgresql://ostodvandi:ostodvandi@127.0.0.1:5432/ostodvandi"
# POSTGRES_PRISMA_URL=
# POSTGRES_URL=
# POSTGRES_URL_NON_POOLING=

# Clinic staff login (medical records). Change before any real use.
CLINIC_USERNAME="klinik"
CLINIC_PASSWORD="klinik"
AUTH_SECRET="change-me-in-production"
# NEXTAUTH_SECRET=   # also accepted as AUTH_SECRET fallback

# Shown on sjúkraskýrsla and in the shell
CLINIC_STAFF_NAME="Kolbrún Arna"
CLINIC_FROM_EMAIL="Óstöðvandi <ostodvandi@ostodvandi.is>"
APP_URL="http://127.0.0.1:4317"
# NEXTAUTH_URL=https://your-app.vercel.app

# Resend — optional. Without this key, emails are stored locally as mock.
RESEND_API_KEY=""

# Shopify — optional. Clinic UI works without these.
SHOPIFY_SHOP_DOMAIN="ostodvandi.myshopify.com"
SHOPIFY_API_KEY=""
SHOPIFY_API_SECRET=""
# Webhook HMAC uses SHOPIFY_WEBHOOK_SECRET, then SHOPIFY_API_SECRET (app secret).
SHOPIFY_WEBHOOK_SECRET=""

# Sesami (booking on the Shopify store) — same names as the old Darrwin project.
SESAMI_WEBHOOK_SECRET=""
SESAMI_API_KEY=""
SESAMI_API_BASE="https://api.sesami.co/v1"
